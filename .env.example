# MongoDB Atlas
# The database name MUST be in the URI path, otherwise MongoDB silently uses a
# database called "test" and every write lands there instead of the real data.
#   ...mongodb.net/jewel-magazine?retryWrites=true&w=majority
MONGODB_URI=
JWT_SECRET=

# ImageKit (server-side image storage)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Salt for hashing voter IPs. Use a long random string.
VOTE_IP_SALT=
