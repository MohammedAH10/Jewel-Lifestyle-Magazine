{
  "name": "AdInquiry",
  "type": "object",
  "properties": {
    "contact_name": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "ad_type": {
      "type": "string",
      "enum": [
        "Magazine Print Ad",
        "Digital Ad",
        "Sponsored Content",
        "Event Sponsorship",
        "Other"
      ]
    },
    "message": {
      "type": "string"
    },
    "budget_range": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "New",
        "Contacted",
        "In Progress",
        "Closed"
      ],
      "default": "New"
    }
  },
  "required": [
    "contact_name",
    "email",
    "ad_type",
    "message"
  ]
}
