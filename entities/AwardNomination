{
  "name": "AwardNomination",
  "type": "object",
  "properties": {
    "nominee_name": {
      "type": "string"
    },
    "nominee_title": {
      "type": "string"
    },
    "nominee_company": {
      "type": "string"
    },
    "award_category": {
      "type": "string"
    },
    "nominator_name": {
      "type": "string"
    },
    "nominator_email": {
      "type": "string",
      "format": "email"
    },
    "reason": {
      "type": "string"
    },
    "supporting_links": {
      "type": "string"
    },
    "year": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "Under Review",
        "Shortlisted",
        "Winner",
        "Not Selected"
      ],
      "default": "Pending"
    }
  },
  "required": [
    "nominee_name",
    "award_category",
    "nominator_name",
    "nominator_email",
    "reason"
  ]
}
