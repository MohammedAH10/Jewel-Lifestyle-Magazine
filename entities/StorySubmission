{
  "name": "StorySubmission",
  "type": "object",
  "properties": {
    "submitter_name": {
      "type": "string"
    },
    "submitter_email": {
      "type": "string",
      "format": "email"
    },
    "submitter_phone": {
      "type": "string"
    },
    "story_title": {
      "type": "string"
    },
    "story_type": {
      "type": "string",
      "enum": [
        "Executive Interview",
        "Lifestyle Feature",
        "Business Story",
        "Event Coverage",
        "Other"
      ]
    },
    "story_description": {
      "type": "string"
    },
    "attachment_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "Reviewed",
        "Approved",
        "Rejected"
      ],
      "default": "Pending"
    }
  },
  "required": [
    "submitter_name",
    "submitter_email",
    "story_title",
    "story_description"
  ]
}
